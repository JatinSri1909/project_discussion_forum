{
  "name": "project-discussion-forum",
  "version": "1.0.0",
  "description": "A Reddit-style discussion forum system for projects",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:perf": "jest --config jest.perf.config.js",
    "lint": "eslint . --ext .ts",
    "seed": "ts-node scripts/seed.ts",
    "docker:build": "docker build -t discussion-forum .",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.33.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.6",
    "slugify": "^1.6.6",
    "zod": "^3.22.2",
    "express-rate-limit": "^6.9.0",
    "winston": "^3.10.0",
    "marked": "^7.0.4",
    "highlight.js": "^11.8.0",
    "rate-limiter-flexible": "^2.4.1",
    "xss": "^1.0.14",
    "sanitize-html": "^2.11.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.5.7",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "autocannon": "^7.11.0",
    "@types/ws": "^8.5.5"
  }
}
