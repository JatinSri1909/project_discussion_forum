{
  "name": "project_discussion_forum",
  "version": "1.0.0",
  "description": "A Reddit-style discussion forum system for projects",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --config jest.perf.config.js",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "supabase migration up",
    "migrate:down": "supabase migration down",
    "seed": "ts-node scripts/seed.ts",
    "docker:build": "docker build -t discussion-forum .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "autocannon": "^7.11.0",
    "cors": "^2.8.5",
    "cron": "^2.4.3",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.2.1",
    "helmet": "^6.2.0",
    "highlight.js": "^11.8.0",
    "marked": "^5.0.2",
    "morgan": "^1.10.0",
    "rate-limiter-flexible": "^2.4.1",
    "sanitize-html": "^2.10.0",
    "winston": "^3.8.2",
    "ws": "^8.13.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/autocannon": "^7.9.0",
    "@types/cors": "^2.8.13",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.17",
    "@types/highlight.js": "^10.1.0",
    "@types/jest": "^29.5.1",
    "@types/marked": "^5.0.0",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.16.3",
    "@types/sanitize-html": "^2.9.0",
    "@types/supertest": "^2.0.12",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.39.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/project_discussion_forum.git"
  },
  "keywords": [
    "forum",
    "discussion",
    "projects",
    "comments",
    "typescript",
    "express",
    "supabase"
  ],
  "author": "",
  "license": "MIT"
}
